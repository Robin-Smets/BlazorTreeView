@using BlazorTreeView.Models
@namespace BlazorTreeView.Components

<div class="tree-view">
    @if (Nodes != null && Nodes.Count > 0)
    {
        @foreach (var node in Nodes)
        {
            @RenderNode(node, 0)
        }
    }
    else
    {
        <div class="tree-view-empty">No data</div>
    }
</div>

@code {
    [Parameter]
    public List<TreeNodeData<object>>? Nodes { get; set; }

    [Parameter]
    public EventCallback<TreeNodeData<object>> OnNodeToggled { get; set; }

    [Parameter]
    public EventCallback<TreeNodeData<object>> OnNodeSelected { get; set; }

    private RenderFragment RenderNode(TreeNodeData<object> node, int level) => @<div class="tree-node">
        <div class="tree-node-content" style="margin-left: @(level * 20)px">
            @if (node.Children.Count > 0)
            {
                <button class="tree-node-toggle" @onclick="@(async () => await ToggleNode(node))">
                    @if (node.IsExpanded)
                    {
                        <span>▼</span>
                    }
                    else
                    {
                        <span>▶</span>
                    }
                </button>
            }
            else
            {
                <span class="tree-node-spacer"></span>
            }
            
            @if (node.IsSelectable)
            {
                <button class="tree-node-label" @onclick="@(async () => await SelectNode(node))">
                    @node.Label
                </button>
            }
            else
            {
                <span class="tree-node-label-disabled">@node.Label</span>
            }

            @if (node.DisplayData != null)
            {
                @foreach (var kvp in node.DisplayData)
                {  // TODO: Above left alignt, smaller and gray the Key            
                    <span class="tree-node-data">@kvp.Value</span>
                }
            }
        </div>

        @if (node.IsExpanded && node.Children.Count > 0)
        {
            <div class="tree-node-children">
                @foreach (var child in node.Children)
                {
                    @RenderNode(child, level + 1)
                }
            </div>
        }
    </div>;

    private async Task ToggleNode(TreeNodeData<object> node)
    {
        node.IsExpanded = !node.IsExpanded;
        await OnNodeToggled.InvokeAsync(node);
        StateHasChanged();
    }

    private async Task SelectNode(TreeNodeData<object> node)
    {
        await OnNodeSelected.InvokeAsync(node);
        StateHasChanged();
    }
}
