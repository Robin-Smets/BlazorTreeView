@using BlazorTreeView.Models
@namespace BlazorTreeView.Components

<div class="tree-view">
    @if (Nodes != null && Nodes.Count > 0)
    {
        @foreach (var node in Nodes)
        {
            <TreeNode 
                Node="node" 
                OnNodeToggled="HandleNodeToggled"
                OnNodeSelected="HandleNodeSelected"
                Level="0" />
        }
    }
    else
    {
        <div class="tree-view-empty">No data</div>
    }
</div>

@typeparam T

@code {
    /// <summary>
    /// The root nodes to display in the tree.
    /// </summary>
    [Parameter]
    public List<TreeNodeData<T>>? Nodes { get; set; }

    /// <summary>
    /// Callback fired when a node is expanded or collapsed.
    /// </summary>
    [Parameter]
    public EventCallback<TreeNodeData<T>> OnNodeToggled { get; set; }

    /// <summary>
    /// Callback fired when a node is selected.
    /// </summary>
    [Parameter]
    public EventCallback<TreeNodeData<T>> OnNodeSelected { get; set; }

    private async Task HandleNodeToggled(TreeNodeData<T> node)
    {     
        await OnNodeToggled.InvokeAsync(node);
        StateHasChanged();
    }

    private async Task HandleNodeSelected(TreeNodeData<T> node)
    {
        await OnNodeSelected.InvokeAsync(node);
        StateHasChanged();
    }
}
