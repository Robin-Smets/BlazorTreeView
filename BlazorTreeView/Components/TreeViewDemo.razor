@namespace BlazorTreeView.Components

<div class="tree-view-demo">
    <h3>TreeView Demo</h3>
    
    @if (SampleNodes != null)
    {
        <TreeView 
            Nodes="SampleNodes" 
            OnNodeToggled="HandleNodeToggled"
            OnNodeSelected="HandleNodeSelected" />
    }

    @if (!string.IsNullOrEmpty(selectedNodeLabel))
    {
        <div class="demo-info">
            <strong>Selected:</strong> @selectedNodeLabel
        </div>
    }
</div>

@code {
    private List<TreeNodeData>? SampleNodes;
    private string selectedNodeLabel = string.Empty;

    protected override void OnInitialized()
    {
        // Create sample tree data
        SampleNodes = new List<TreeNodeData>
        {
            new TreeNodeData
            {
                Id = "1",
                Label = "Documents",
                Children = new List<TreeNodeData>
                {
                    new TreeNodeData { Id = "1.1", Label = "Project A" },
                    new TreeNodeData 
                    { 
                        Id = "1.2", 
                        Label = "Project B",
                        Children = new List<TreeNodeData>
                        {
                            new TreeNodeData { Id = "1.2.1", Label = "Design" },
                            new TreeNodeData { Id = "1.2.2", Label = "Implementation" }
                        }
                    }
                }
            },
            new TreeNodeData
            {
                Id = "2",
                Label = "Media",
                IsExpanded = true,
                Children = new List<TreeNodeData>
                {
                    new TreeNodeData { Id = "2.1", Label = "Screenshots" },
                    new TreeNodeData { Id = "2.2", Label = "Icons" }
                }
            },
            new TreeNodeData
            {
                Id = "3",
                Label = "Archive",
                Children = new List<TreeNodeData>
                {
                    new TreeNodeData { Id = "3.1", Label = "Old Projects" },
                    new TreeNodeData { Id = "3.2", Label = "Backups" }
                }
            }
        };
    }

    private Task HandleNodeToggled(TreeNodeData node)
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task HandleNodeSelected(TreeNodeData node)
    {
        selectedNodeLabel = node.Label;
        StateHasChanged();
        return Task.CompletedTask;
    }
}

<style>
    .tree-view-demo {
        padding: 16px;
        border: 1px solid #ddd;
        border-radius: 4px;
        background-color: #fafafa;
    }

    .tree-view-demo h3 {
        margin-top: 0;
        color: #333;
    }

    .demo-info {
        margin-top: 12px;
        padding: 8px;
        background-color: #e8f5e9;
        border-left: 4px solid #4caf50;
        color: #2e7d32;
        border-radius: 2px;
    }
</style>
